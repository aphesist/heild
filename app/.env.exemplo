# Onde os dados do wireframe ficam (src/nucleo/banco):
#   local     (padrão) localStorage deste navegador
#   indexeddb IndexedDB deste navegador
#   supabase  Postgres no Supabase, com RLS por escritório (ver supabase/README.md)
#   memoria   nada persiste
VITE_HEILD_BANCO=local

# Só com VITE_HEILD_BANCO=supabase. Copie para .env.local (fora do git) e preencha.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Conta de demonstração com app_metadata.escritorio_id (entra sozinha ao abrir).
VITE_SUPABASE_EMAIL=
VITE_SUPABASE_SENHA=
