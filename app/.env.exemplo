# Onde os dados do wireframe ficam (src/nucleo/banco):
#   local     (padrão) localStorage deste navegador; roda sem rede
#   indexeddb IndexedDB deste navegador
#   supabase  Postgres no Supabase da Heild, com RLS por escritório (ver docs/wireframe/ARQUITETURA.md, seção 9)
#   api       a API do backend real (branch backend, servidor/): ver docs/backend/IMPLEMENTACAO.md, seção B1
#   memoria   nada persiste
VITE_HEILD_BANCO=local

# Só com VITE_HEILD_BANCO=api: onde a API local está (npm run dev na raiz do repositório).
VITE_HEILD_API_URL=http://127.0.0.1:8787

# Só com VITE_HEILD_BANCO=supabase. Copie para .env.local (fora do git) e preencha as senhas.
# A URL e a chave publicável podem ficar aqui: são feitas para o navegador e a RLS está ligada.
# Nunca ponha aqui a chave secreta nem a service_role.
VITE_SUPABASE_URL=https://jccwtyeqookthkonbbxn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_KkBYUyCayINnB9IFyOogtA_0iSg-0nO

# Uma conta de demonstração por escritório de exemplo (o JWT de cada uma só vê o próprio escritório;
# trocar de escritório no painel Demonstração troca a conta). As senhas não vão para o git.
VITE_SUPABASE_EMAIL_ESC_ANDRADE=demo-andrade@heild.app
VITE_SUPABASE_SENHA_ESC_ANDRADE=
VITE_SUPABASE_EMAIL_ESC_HORIZONTE=demo-horizonte@heild.app
VITE_SUPABASE_SENHA_ESC_HORIZONTE=
